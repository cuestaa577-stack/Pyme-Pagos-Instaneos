{
  "name": "pyme-pagos-instantaneos",
  "version": "1.0.0",
  "description": "Plataforma propia de pagos y remesas instantáneas para Venezuela (dLocal Go, BRE-B, PSE, Pago Móvil VE).",
  "main": "index.js",
  "scripts": {
    "start": "node server/scripts/preflight.js && exec node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node test/e2e.js",
    "preflight": "node server/scripts/preflight.js",
    "backup": "node server/scripts/backup.js",
    "restore": "node server/scripts/backup.js --restore"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "nanoid": "^6.0.2",
    "zod": "^4.6.7"
  }
}
